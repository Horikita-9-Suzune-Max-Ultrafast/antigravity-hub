    "pack:release": "node --no-warnings scripts/pack-release.mjs",
    "doctor": "node --no-warnings scripts/doctor.mjs",
    "test": "node --no-warnings --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "esbuild": "^0.25.0"
  }
