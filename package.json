{
  "name": "context-cache",
  "version": "1.5.0",
  "description": "Host-agnostic context cache, multi-agent telemetry, floating monitor, and native Antigravity MCP App plugin",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "ctx-cache": "./bin/ctx.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:ui": "node --no-warnings src/ui/build-ui.mjs",
