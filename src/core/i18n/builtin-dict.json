  "patterns": [
    {
      "regex": "^(\\d+) files? changed$",
      "flags": "i",
      "replace": "$1 个文件已变更",
      "note": "Diff summary file count"
    },
    {
      "regex": "^(\\d+) files?$",
      "flags": "i",
      "replace": "$1 个文件",
      "note": "File count badge"
    },
    {
      "regex": "^(\\d+) folders?$",
      "flags": "i",
      "replace": "$1 个文件夹",
      "note": "Folder count badge"
    },
    {
      "regex": "^(\\d+) seconds? ago$",
      "flags": "i",
      "replace": "$1 秒前",
      "note": "Relative time seconds"
    },
    {
      "regex": "^(\\d+) minutes? ago$",
      "flags": "i",
      "replace": "$1 分钟前",
      "note": "Relative time minutes"
    },
    {
      "regex": "^(\\d+) hours? ago$",
      "flags": "i",
      "replace": "$1 小时前",
      "note": "Relative time hours"
    },
    {
      "regex": "^(\\d+) days? ago$",
      "flags": "i",
      "replace": "$1 天前",
      "note": "Relative time days"
    },
    {
      "regex": "^(\\d+) weeks? ago$",
      "flags": "i",
      "replace": "$1 周前",
      "note": "Relative time weeks"
    },
    {
      "regex": "^(\\d+) months? ago$",
      "flags": "i",
      "replace": "$1 个月前",
      "note": "Relative time months"
    },
    {
      "regex": "^Step (\\d+) of (\\d+)$",
      "flags": "i",
      "replace": "第 $1 / $2 步",
      "note": "Step progress indicator"
    },
    {
      "regex": "^Showing (\\d+) of (\\d+)$",
      "flags": "i",
      "replace": "显示 $1 / $2 项",
      "note": "Pagination summary"
    },
    {
      "regex": "^(\\d+) of (\\d+) selected$",
      "flags": "i",
      "replace": "已选 $1 / $2 项",
      "note": "Partial selection count"
    },
    {
      "regex": "^(\\d+) selected$",
      "flags": "i",
      "replace": "已选 $1 项",
      "note": "Selection count"
    },
    {
      "regex": "^(\\d+) results?$",
      "flags": "i",
      "replace": "$1 条结果",
      "note": "Search result count"
    },
    {
      "regex": "^(\\d+) matches?$",
      "flags": "i",
      "replace": "$1 个匹配项",
      "note": "Search match count"
    },
    {
      "regex": "^(\\d+) warnings?$",
      "flags": "i",
      "replace": "$1 项警告",
      "note": "Warning count"
    },
    {
      "regex": "^(\\d+) errors?$",
      "flags": "i",
      "replace": "$1 项错误",
      "note": "Error count"
    },
    {
      "regex": "^(\\d+) problems?$",
      "flags": "i",
      "replace": "$1 个问题",
      "note": "Problem count"
    },
    {
      "regex": "^(\\d+) items?$",
      "flags": "i",
      "replace": "$1 项",
      "note": "Generic item count"
    },
    {
      "regex": "^(\\d+) conversations?$",
      "flags": "i",
      "replace": "$1 个对话",
      "note": "Conversation count"
    },
    {
      "regex": "^(\\d+) tasks?$",
      "flags": "i",
      "replace": "$1 个任务",
      "note": "Task count"
    },
    {
      "regex": "^(\\d+) tools?$",
      "flags": "i",
      "replace": "$1 个工具",
      "note": "Tool count"
    },
    {
      "regex": "^Search (.+)\\.\\.\\.$",
      "flags": "i",
      "replace": "搜索 $1...",
      "note": "Dynamic search placeholder"
    },
    {
      "regex": "^Filter (.+)\\.\\.\\.$",
      "flags": "i",
      "replace": "筛选 $1...",
      "note": "Dynamic filter placeholder"
    },
    {
      "regex": "^Version (.+)$",
      "flags": "i",
      "replace": "版本 $1",
      "note": "Version label"
    },
    {
      "regex": "^Open (.+)$",
      "flags": "i",
      "replace": "打开 $1",
      "note": "Open target action"
    },
    {
      "regex": "^Close (.+)$",
      "flags": "i",
      "replace": "关闭 $1",
      "note": "Close target action"
    },
    {
      "regex": "^Delete (.+)\\?$",
      "flags": "i",
      "replace": "确定删除 $1 吗？",
      "note": "Delete confirmation prompt"
    },
    {
      "regex": "^Updated (.+)$",
      "flags": "i",
      "replace": "更新于 $1",
      "note": "Updated timestamp"
    },
    {
      "regex": "^Created (.+)$",
      "flags": "i",
      "replace": "创建于 $1",
      "note": "Created timestamp"
    },
    {
      "regex": "^Ran for (\\d+(?:\\.\\d+)?)s$",
      "flags": "i",
      "replace": "已运行 $1 秒",
      "note": "Command duration"
    },
    {
      "regex": "^Exited with code (-?\\d+)$",
      "flags": "i",
      "replace": "退出码 $1",
      "note": "Process exit code"
    },
    {
      "regex": "^(\\d+) lines? added$",
      "flags": "i",
      "replace": "新增 $1 行",
      "note": "Diff lines added"
    },
    {
      "regex": "^(\\d+) lines? removed$",
      "flags": "i",
      "replace": "删除 $1 行",
      "note": "Diff lines removed"
    }
  ]
